# Texas Smile Studio — Environment Variables Template
# Copy to .env.local for production credentials.
# In local development without external keys, /api/bookings validates via Zod,
# enforces IP rate limiting, and persists bookings to .data/bookings.json.

# Optional: Supabase PostgreSQL persistence (Option A)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional: Resend transactional email notifications to clinic desk
RESEND_API_KEY=re_your_api_key_here
CLINIC_NOTIFICATION_EMAIL=concierge@texassmilestudio.com

# Public site URL for canonical & OpenGraph metadata
NEXT_PUBLIC_SITE_URL=https://texassmilestudio.com
